NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL Database (use docker-compose to run: docker-compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackprep

UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_FILE_SIZE=104857600

# Audio Analysis
ENABLE_AUDIO_ANALYSIS=true
ANALYSIS_WORKERS=2

# API Configuration & Security
# CORS_ORIGIN: comma-separated list of allowed origins (default: * for development)
CORS_ORIGIN=*
# API_KEY: optional API key for protecting endpoints (leave empty to disable)
API_KEY=
