NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL Database (use docker-compose to run: docker-compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackprep

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Audio Analysis
ENABLE_AUDIO_ANALYSIS=true
ANALYSIS_WORKERS=2

# API Configuration
CORS_ORIGIN=*
API_KEY=
